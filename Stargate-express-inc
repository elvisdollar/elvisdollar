<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Shipping & Receiving - Stargate Express</title>
<style>
  body {
    font-family: Arial, sans-serif;
    max-width: 600px;
    margin: 40px auto;
    padding: 0 20px;
    background: #f9f9f9;
    color: #333;
  }
  h1 {
    text-align: center;
    color: #004aad;
  }
  .links {
    text-align: center;
    margin: 20px 0;
  }
  .links a {
    display: inline-block;
    margin: 0 15px;
    padding: 10px 20px;
    background: #004aad;
    color: white;
    text-decoration: none;
    border-radius: 6px;
    font-weight: bold;
  }
  .links a:hover {
    background: #00317a;
  }
  form {
    background: white;
    padding: 20px;
    border-radius: 8px;
    box-shadow: 0 0 8px #ccc;
  }
  label {
    display: block;
    margin: 15px 0 6px;
    font-weight: bold;
  }
  input[type="number"] {
    width: 100%;
    padding: 8px;
    font-size: 1rem;
  }
  button {
    margin-top: 20px;
    background: #004aad;
    color: white;
    border: none;
    padding: 12px 20px;
    font-size: 1rem;
    border-radius: 6px;
    cursor: pointer;
    width: 100%;
  }
  button:hover {
    background: #00317a;
  }
  .result {
    margin-top: 20px;
    font-size: 1.2rem;
    font-weight: bold;
    color: #007700;
    text-align: center;
  }
</style>
</head>
<body>

<h1>Stargate Express Shipping Calculator</h1>

<div class="links">
  <a href="https://www.fedex.com/apps/fedextrack/" target="_blank" rel="noopener">FedEx Tracking</a>
  <a href="https://www.ups.com/track" target="_blank" rel="noopener">UPS Tracking</a>
</div>

<form id="shippingForm">
  <label for="weight">Weight (lbs):</label>
  <input type="number" id="weight" name="weight" min="0" step="0.1" required />

  <label for="length">Length (inches):</label>
  <input type="number" id="length" name="length" min="0" step="0.1" required />

  <label for="width">Width (inches):</label>
  <input type="number" id="width" name="width" min="0" step="0.1" required />

  <label for="height">Height (inches):</label>
  <input type="number" id="height" name="height" min="0" step="0.1" required />

  <button type="submit">Calculate Shipping Cost</button>
</form>

<div class="result" id="result"></div>

<script>
  // Example simple shipping cost calculator
  // Formula: Base $5 + (Weight in lbs * $1.2) + (Volumetric factor * $0.02)
  // Volumetric factor = length * width * height / 139 (standard divisor for dimensional weight)
  
  document.getElementById('shippingForm').addEventListener('submit', function(e) {
    e.preventDefault();

    const weight = parseFloat(document.getElementById('weight').value);
    const length = parseFloat(document.getElementById('length').value);
    const width = parseFloat(document.getElementById('width').value);
    const height = parseFloat(document.getElementById('height').value);

    if (weight <= 0 || length <= 0 || width <= 0 || height <= 0) {
      document.getElementById('result').textContent = 'Please enter positive values for all fields.';
      return;
    }

    const volumetricWeight = (length * width * height) / 139;
    const chargeableWeight = Math.max(weight, volumetricWeight);

    const baseCost = 5;
    const costPerPound = 1.2;

    const shippingCost = baseCost + (chargeableWeight * costPerPound);

    document.getElementById('result').textContent = 
      `Estimated Shipping Cost: $${shippingCost.toFixed(2)}`;
  });
</script>

</body>
</html>















